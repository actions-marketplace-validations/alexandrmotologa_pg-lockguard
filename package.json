{
  "name": "pg-lockguard",
  "version": "1.0.0",
  "description": "Zero-downtime PostgreSQL DDL lock analyzer and migration linter",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pg-lockguard": "./dist/bin/pg-lockguard.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "postgres",
    "postgresql",
    "ddl",
    "locks",
    "linter",
    "migration",
    "zero-downtime",
    "sarif",
    "static-analysis",
    "ci-cd"
  ],
  "author": "Alexandr Motologa <alexandrmotologa@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandrmotologa/pg-lockguard.git"
  },
  "bugs": {
    "url": "https://github.com/alexandrmotologa/pg-lockguard/issues"
  },
  "homepage": "https://github.com/alexandrmotologa/pg-lockguard#readme",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "glob": "^13.0.6",
    "libpg-query-wasm": "^0.2.1",
    "pg": "^8.23.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^20.14.9",
    "@types/pg": "^8.23.1",
    "typescript": "^5.5.2",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
